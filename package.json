{
  "name": "laminar-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "start": "npm run start --workspace laminar-example",
    "android": "npm run android --workspace laminar-example",
    "ios": "npm run ios --workspace laminar-example",
    "web": "npm run web --workspace laminar-example",
    "lint": "npm run lint --workspace laminar-example",
    "example:typecheck": "npm run typecheck --workspace laminar-example",
    "test": "npm run test:packages",
    "test:packages": "npm run test --workspace packages/laminar",
    "test:ci": "npm run test:ci --workspace packages/laminar",
    "test:coverage": "npm run test:coverage --workspace packages/laminar",
    "typecheck": "npm run typecheck --workspace packages/laminar",
    "quality": "npm run quality --workspace packages/laminar"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  }
}
